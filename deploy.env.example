# Site settings for scripts/deploy.sh. Copy to deploy.env (gitignored) and fill in.
# Only the edge Worker uses them; everything else in apps/*/wrangler.jsonc is account-neutral.

# Custom domain of the edge (the dashboard, /api, /git and /mcp). Must be a zone on your account.
QUEENOS_HOST=queenos.example.com

# Zero Trust team name: <team>.cloudflareaccess.com.
QUEENOS_ACCESS_TEAM=example

# Comma-separated email domains allowed to sign in (a second check behind the Access policy).
QUEENOS_ALLOWED_EMAIL_DOMAINS=example.com

# Application Audience (AUD) tag of the main Access app. Leave empty for the first deploy,
# then fill it in and run scripts/deploy.sh --only edge. Empty fails closed (503).
QUEENOS_ACCESS_AUD=

# Your account id. wrangler deploys to it, and the edge's Metrics page reads Analytics Engine with it.
CLOUDFLARE_ACCOUNT_ID=
