# Copy to .dev.vars for `wrangler dev`. In production: `wrangler secret put CF_AIG_TOKEN`.
#
# AI Gateway auth token (authenticated gateway + BYOK stored provider keys).
# Sent as `cf-aig-authorization: Bearer <token>`. Only used by the Scribe, and
# only when it runs in LLM mode (SCRIBE_MODE=llm, or auto with GATE_TEST_MODE!=scripted).
# Without it the Scribe uses the deterministic extractive summarizer.
CF_AIG_TOKEN=

# Optional overrides of wrangler.jsonc vars:
# GATE_TEST_MODE=scripted
# SCRIBE_MODE=llm
# AI_GATEWAY_ACCOUNT_ID=<cloudflare account id>
# POLICY_ALLOWED_DEPS=hono,zod,@queenos/*
