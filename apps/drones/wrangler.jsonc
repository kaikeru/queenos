{
  "$schema": "node_modules/wrangler/config-schema.json",
  // apps/queen binds to this Worker by name ("script_name": "queenos-drones").
  "name": "queenos-drones",
  "main": "src/index.ts",
  // Implies nodejs_compat (+v2): isomorphic-git's bare `Buffer` global works
  // with no flags (docs/discovery.md §2). Do not add nodejs_compat.
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  // isomorphic-git pack/sha1 work is CPU-heavy; Workflow steps may use up to 5 min.
  "limits": { "cpu_ms": 300000 },
  "workflows": [
    {
      // apps/queen's DRONES binding names this workflow + class.
      "name": "drone-workflow",
      "binding": "DRONE_WORKFLOW",
      "class_name": "DroneWorkflow"
    }
  ],
  // Workers AI binding: LLM calls go through AI Gateway "queenos" (pre-authenticated, no token).
  "ai": { "binding": "AI" },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "queenos" }],
  "durable_objects": {
    "bindings": [
      // Cross-script DO RPC to the Queen (apps/queen wrangler "name": "queen").
      // One QueenNode per hive: QUEEN.idFromName(namespace).
      { "name": "QUEEN", "class_name": "QueenNode", "script_name": "queen" },
      // The tool-loop coding agent (@cloudflare/think): one DO per (Workflow instance, model).
      { "name": "BUILDER", "class_name": "BuilderAgent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuilderAgent"] }],
  // Dynamic Workers: the agent's verify tool loads the edited Worker here (no network, 100 ms CPU).
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": {
    // "live" calls the LLM via the AI binding through AI Gateway; "scripted" returns a deterministic
    // change set (demo video, tests). Git + Artifacts run for real in both.
    "DRONE_LLM_MODE": "live",
    // Live builder: "agent" (Think tool loop + Dynamic Worker verify) or "single-shot" (legacy JSON change set).
    "DRONE_HARNESS": "agent",
    // Artificial "thinking" time in scripted mode (durable step.sleep).
    "DRONE_SCRIPTED_DELAY_MS": "4000",
    "AI_GATEWAY_ID": "queenos",
    // Fallback model when the Queen sends no modelChoice (it normally picks per task). Workers AI ("@cf/...").
    "MODEL_BUILDER": "@cf/zai-org/glm-5.3-flash"
  },
  "env": {
    // Used only by vitest (see vitest.config.ts). Named envs do not inherit
    // bindings: no ARTIFACTS (remote-only) and no cross-script QUEEN DO (the pool
    // has no dev registry). Tests inject fake ports via test/worker.ts.
    "test": {
      "workflows": [{ "name": "drone-workflow", "binding": "DRONE_WORKFLOW", "class_name": "DroneWorkflow" }],
      // The smoke test drives a real BuilderAgent (test/worker.ts subclass) with a mock model.
      "durable_objects": { "bindings": [{ "name": "BUILDER", "class_name": "BuilderAgent" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BuilderAgent"] }],
      "vars": {
        "DRONE_HARNESS": "agent",
        "DRONE_LLM_MODE": "scripted",
        "DRONE_SCRIPTED_DELAY_MS": "0",
        "AI_GATEWAY_ID": "queenos",
        "MODEL_BUILDER": "@cf/zai-org/glm-5.3-flash"
      }
    }
  }
}
