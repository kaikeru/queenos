{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The single public front door: your custom domain, behind Cloudflare Access.
  // Site-specific values (custom domain, Access team, email domains, AUD, account id) are left
  // empty here: scripts/deploy.sh fills them in from deploy.env (see deploy.env.example).
  // Every other Worker has workers_dev:false and is reachable only through here.
  "name": "queenos-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  // *.workers.dev would bypass the Access app (docs/deploy-discovery.md section 8).
  "workers_dev": false,
  "preview_urls": false,
  // Observability: structured JSON logs with trace context are filtered via trace_id.
  // To opt into Workers Traces (beta), uncomment and redeploy:
  // "observability": {"enabled": true, "head_sampling_rate": 1, "traces": {"enabled": true}}
  "observability": {"enabled": true, "head_sampling_rate": 1},
  // scripts/deploy.sh adds { "pattern": QUEENOS_HOST, "custom_domain": true }.
  "routes": [],
  "assets": {
    // The War Room SPA. Build it first: pnpm --filter @queenos/dashboard build.
    "directory": "../dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else is served straight from assets (Access already gates the host).
    "run_worker_first": ["/api/*", "/hives/*", "/git/*", "/mcp", "/mcp/*", "/health"]
  },
  "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "HiveRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiveRegistry"] }],
  "services": [
    { "binding": "VAULT", "service": "queenos-vault", "entrypoint": "VaultWriter" },
    { "binding": "GENESIS", "service": "queenos-genesis" },
    { "binding": "QUEEN", "service": "queen" },
    { "binding": "GIT", "service": "queenos-git" },
    { "binding": "MCP", "service": "queenos-mcp" }
  ],
  "vars": {
    // Set by scripts/deploy.sh from deploy.env. Empty values fail closed.
    "ACCESS_TEAM": "",
    "ALLOWED_EMAIL_DOMAINS": "",
    // Application Audience (AUD) tag of the Access app. Empty fails closed (503).
    "ACCESS_AUD": "",
    // For GET /api/metrics (Analytics Engine SQL API). Secret ANALYTICS_API_TOKEN (Account
    // Analytics Read): wrangler secret put ANALYTICS_API_TOKEN. Unset => 503, dashboard uses rollups.
    "ACCOUNT_ID": ""
  },
  "env": {
    // Local dev (`wrangler dev --env dev`): skips Access verification. Never deploy.
    "dev": {
      // Keep the unsuffixed name: Genesis binds this Worker's HiveRegistry by script_name
      // "queenos-edge", and wrangler would otherwise name it "queenos-edge-dev".
      "name": "queenos-edge",
      "workers_dev": false,
      "routes": [],
      "assets": {
        "directory": "../dashboard/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/hives/*", "/git/*", "/mcp", "/mcp/*", "/health"]
      },
      "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "HiveRegistry" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiveRegistry"] }],
      "services": [
        { "binding": "VAULT", "service": "queenos-vault", "entrypoint": "VaultWriter" },
        { "binding": "GENESIS", "service": "queenos-genesis" },
        { "binding": "QUEEN", "service": "queen" },
        { "binding": "GIT", "service": "queenos-git" },
        { "binding": "MCP", "service": "queenos-mcp" }
      ],
      "vars": {
        "ACCESS_TEAM": "example",
        "ALLOWED_EMAIL_DOMAINS": "example.com",
        "ACCESS_AUD": "dev-aud",
        "ACCOUNT_ID": "",
        "ACCESS_MODE": "dev",
        "DEV_USER_EMAIL": "dev@example.com"
      }
    },
    // Used only by vitest. No service bindings or assets: tests inject fakes.
    "test": {
      "routes": [],
      "durable_objects": { "bindings": [{ "name": "REGISTRY", "class_name": "HiveRegistry" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HiveRegistry"] }],
      "vars": {
        "ACCESS_TEAM": "example",
        "ALLOWED_EMAIL_DOMAINS": "example.org",
        "ACCESS_AUD": "test-aud"
      }
    }
  }
}
