{
  "name": "@queenos/queen",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:sim": "wrangler dev --env sim",
    "deploy": "wrangler deploy --env=\"\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --include-runtime=false",
    "test": "vitest run",
    "test:load": "VITE_QUEEN_LOAD=1 vitest run test/load.test.ts"
  },
  "dependencies": {
    "@queenos/queen-types": "workspace:*",
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@queenos/eslint-config": "workspace:*",
    "@queenos/tsconfig": "workspace:*",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
