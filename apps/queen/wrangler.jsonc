{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queen",
  // Reachable only through queenos-edge (service binding), never via *.workers.dev.
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "durable_objects": {
    "bindings": [{ "name": "QUEEN_NODE", "class_name": "QueenNode" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueenNode"] }],
  // The Queen orchestrates only: no Artifacts binding. Every side effect runs
  // in an executor Workflow reached through a cross-script binding; each
  // `script_name` must be the deployed name of that app (its wrangler "name").
  "workflows": [
    {
      // Drones (build / rework / land): apps/drones.
      "binding": "DRONES",
      "name": "drone-workflow",
      "class_name": "DroneWorkflow",
      "script_name": "queenos-drones"
    },
    {
      // Provisioner (Artifacts fork / delete): apps/provisioner.
      "binding": "PROVISIONER",
      "name": "provisioner-workflow",
      "class_name": "ProvisionerWorkflow",
      "script_name": "queenos-provisioner"
    },
    {
      // Herald (Worker Preview deploy / teardown): apps/herald.
      "binding": "HERALD",
      "name": "herald-workflow",
      "class_name": "HeraldWorkflow",
      "script_name": "queenos-herald"
    }
  ],
  "vars": {
    // Command watchdog: a FORK / DELETE / DEPLOY / TEARDOWN command or drone
    // task unreported for this long is re-issued under a new id (then failed
    // after the attempt cap). Milliseconds; default 10 min.
    "COMMAND_TIMEOUT_MS": "600000"
  },
  // Secret (not in this file): `wrangler secret put QUEEN_INTERNAL_TOKEN`.
  // Guards /internal/*, /audit, /scribe, /trains/:id/result. See .dev.vars.example.
  "env": {
    // Local demo: `pnpm dev:sim`. Named envs do not inherit bindings, so this
    // env has the DO but no Workflows; src/sim/worker.ts injects a fake
    // Provisioner, Herald and auto-advancing drones. No Cloudflare credentials,
    // LLM or Workflow needed.
    "sim": {
      // Keep the unsuffixed name: the edge and Genesis bind "queen" by name
      // (wrangler would otherwise name this env's Worker "queen-sim").
      "name": "queen",
      "main": "src/sim/worker.ts",
      // Local demo only: no secret needed. Never set this in the default env.
      "vars": { "QUEEN_INTERNAL_AUTH": "disabled", "COMMAND_TIMEOUT_MS": "600000" },
      "durable_objects": {
        "bindings": [{ "name": "QUEEN_NODE", "class_name": "QueenNode" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueenNode"] }]
    },
    // Used only by vitest (see vitest.config.ts): the DO without Workflows
    // (wrangler warns about that on every test run; it is intentional).
    "test": {
      // Fixed non-secret token so tests exercise the real auth path.
      "vars": { "QUEEN_INTERNAL_TOKEN": "test-internal-token", "COMMAND_TIMEOUT_MS": "600000" },
      "durable_objects": {
        "bindings": [{ "name": "QUEEN_NODE", "class_name": "QueenNode" }]
      }
    }
  }
}
