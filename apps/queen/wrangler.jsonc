{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queen",
  // Reachable only through queenos-edge (service binding), never via *.workers.dev.
  "workers_dev": false,
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "durable_objects": {
    "bindings": [{ "name": "QUEEN_NODE", "class_name": "QueenNode" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueenNode"] }],
  // The Queen orchestrates only: no Artifacts binding. Every side effect runs
  // in an executor Workflow reached through a cross-script binding; each
  // `script_name` must be the deployed name of that app (its wrangler "name").
  "workflows": [
    {
      // Drones (build / rework / land): apps/drones.
      "binding": "DRONES",
      "name": "drone-workflow",
      "class_name": "DroneWorkflow",
      "script_name": "queenos-drones"
    },
    {
      // Provisioner (Artifacts fork / delete): apps/provisioner.
      "binding": "PROVISIONER",
      "name": "provisioner-workflow",
      "class_name": "ProvisionerWorkflow",
      "script_name": "queenos-provisioner"
    },
    {
      // Herald (preview deploy / teardown; staging, canary and rollback): apps/herald.
      "binding": "HERALD",
      "name": "herald-workflow",
      "class_name": "HeraldWorkflow",
      "script_name": "queenos-herald"
    },
    {
      // Sentinel (release health verdicts for staging and canary steps): apps/sentinel.
      "binding": "SENTINEL",
      "name": "sentinel-workflow",
      "class_name": "SentinelWorkflow",
      "script_name": "queenos-sentinel"
    }
  ],
  "vars": {
    // Command watchdog: a FORK / DELETE / DEPLOY / TEARDOWN command or drone
    // task unreported for this long is re-issued under a new id (then failed
    // after the attempt cap). Milliseconds; default 10 min.
    "COMMAND_TIMEOUT_MS": "600000",
    // Sentinel window per staging validation / canary step (seconds; short for
    // demos, minutes for real use) and the minimum candidate requests per window.
    // The watchdog gives Sentinel max(COMMAND_TIMEOUT_MS, window + 5 min).
    "SENTINEL_WINDOW_SECONDS": "60",
    "SENTINEL_MIN_REQUESTS": "100",
    // Model router floor (AIMD): clean builds at the floor before it backs off
    // a tier (K), and floor dispatches above the cheapest tier before a probe
    // one tier lower (N).
    "ROUTER_BACKOFF_STREAK": "3",
    "ROUTER_PROBE_AFTER": "4"
    // Model router: set "MODEL_ROUTER_PIN_BUILDER" to a model id (e.g.
    // "@cf/zai-org/glm-5.3") to force it for every builder / rework drone
    // (demos, debugging). Unset or blank = the Queen routes per task.
  },
  // Secret (not in this file): `wrangler secret put QUEEN_INTERNAL_TOKEN`.
  // Guards /internal/*, /audit, /scribe, /trains/:id/result. See .dev.vars.example.
  "env": {
    // Local demo: `pnpm dev:sim`. Named envs do not inherit bindings, so this
    // env has the DO but no Workflows; src/sim/worker.ts injects a fake
    // Provisioner, Herald and auto-advancing drones. No Cloudflare credentials,
    // LLM or Workflow needed.
    "sim": {
      // Keep the unsuffixed name: the edge and Genesis bind "queen" by name
      // (wrangler would otherwise name this env's Worker "queen-sim").
      "name": "queen",
      "main": "src/sim/worker.ts",
      // Local demo only: no secret needed. Never set this in the default env.
      "vars": {
        "QUEEN_INTERNAL_AUTH": "disabled",
        "COMMAND_TIMEOUT_MS": "600000",
        "SENTINEL_WINDOW_SECONDS": "60",
        "SENTINEL_MIN_REQUESTS": "100",
        "ROUTER_BACKOFF_STREAK": "3",
        "ROUTER_PROBE_AFTER": "4"
      },
      "durable_objects": {
        "bindings": [{ "name": "QUEEN_NODE", "class_name": "QueenNode" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["QueenNode"] }],
      // Mirrors the top-level workflow bindings only to silence wrangler's
      // "workflows exists at the top level, but not on env.sim" warning. They
      // are never invoked: src/sim/worker.ts injects fake executors instead.
      "workflows": [
        { "binding": "DRONES", "name": "drone-workflow", "class_name": "DroneWorkflow", "script_name": "queenos-drones" },
        { "binding": "PROVISIONER", "name": "provisioner-workflow", "class_name": "ProvisionerWorkflow", "script_name": "queenos-provisioner" },
        { "binding": "HERALD", "name": "herald-workflow", "class_name": "HeraldWorkflow", "script_name": "queenos-herald" },
        { "binding": "SENTINEL", "name": "sentinel-workflow", "class_name": "SentinelWorkflow", "script_name": "queenos-sentinel" }
      ]
    },
    // Used only by vitest (see vitest.config.ts): the DO without Workflows
    // (wrangler warns about that on every test run; it is intentional).
    "test": {
      // Fixed non-secret token so tests exercise the real auth path.
      "vars": {
        "QUEEN_INTERNAL_TOKEN": "test-internal-token",
        "COMMAND_TIMEOUT_MS": "600000",
        "SENTINEL_WINDOW_SECONDS": "60",
        "SENTINEL_MIN_REQUESTS": "100",
        "ROUTER_BACKOFF_STREAK": "3",
        "ROUTER_PROBE_AFTER": "4"
      },
      "durable_objects": {
        "bindings": [{ "name": "QUEEN_NODE", "class_name": "QueenNode" }]
      }
    }
  }
}
