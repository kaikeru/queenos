{
  "$schema": "node_modules/wrangler/config-schema.json",
  // queenos-oracle (v2 design §3.3, decision D5): decomposition, TRIAGE dedupe and
  // path prediction. apps/queen will bind to this Worker by name (WP2.1: an ORACLE
  // workflow binding with "script_name": "queenos-oracle"). Deploy it alone first:
  //   wrangler deploy --env=""
  "name": "queenos-oracle",
  "main": "src/index.ts",
  // Implies nodejs_compat (+v2). Do not add nodejs_compat.
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "workflows": [
    {
      // apps/queen's ORACLE binding names this workflow + class (one instance per OracleCommand, id = commandId).
      "name": "oracle-workflow",
      "binding": "ORACLE_WORKFLOW",
      "class_name": "OracleWorkflow"
    }
  ],
  // DECOMPOSE step 0: a read token + depth-1 clone of the hive repo to list its files (best effort).
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "queenos" }],
  // Work-item dedupe (kind = "work-item" vectors). Create the metadata index once:
  //   npx wrangler vectorize create-metadata-index queenos-memory --property-name=kind --type=string
  "vectorize": [{ "binding": "MEMORY", "index_name": "queenos-memory" }],
  // The planner LLM call (router role "planner") and embeddings, via AI Gateway "queenos".
  "ai": { "binding": "AI" },
  // Usage points (fire-and-forget; the dataset appears after the first write).
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "queenos_events" }],
  "durable_objects": {
    "bindings": [
      // Cross-script DO RPC to the Queen (apps/queen wrangler "name": "queen"): reportOracleResult.
      // One QueenNode per hive: QUEEN.idFromName(hive).
      { "name": "QUEEN", "class_name": "QueenNode", "script_name": "queen" }
    ]
  },
  // Structured logs carry trace_id / span_id (§2.6). Traces stay off (early beta); to opt in:
  // "observability": { "enabled": true, "head_sampling_rate": 1, "traces": { "enabled": true } },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "env": {
    // For vitest (WP1.5). Named envs do not inherit bindings: no ARTIFACTS / AI / MEMORY
    // (remote-only) and no cross-script QUEEN DO (the pool has no dev registry). Tests inject fake ports.
    "test": {
      "workflows": [{ "name": "oracle-workflow", "binding": "ORACLE_WORKFLOW", "class_name": "OracleWorkflow" }]
    }
  }
}
