{
  "$schema": "node_modules/wrangler/config-schema.json",
  // apps/queen binds to this Worker by name ("script_name": "queenos-herald").
  "name": "queenos-herald",
  "main": "src/index.ts",
  // Implies nodejs_compat (+v2): isomorphic-git's bare `Buffer` global works
  // with no flags (docs/discovery.md §2). Do not add nodejs_compat.
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  // Observability: structured JSON logs with trace context are filtered via trace_id.
  // To opt into Workers Traces (beta), uncomment and redeploy:
  // "observability": {"enabled": true, "head_sampling_rate": 1, "traces": {"enabled": true}}
  "observability": {"enabled": true, "head_sampling_rate": 1},
  // Clone + REST upload; Workflow steps may use up to 5 min of CPU.
  "limits": { "cpu_ms": 300000 },
  "workflows": [
    {
      // apps/queen's HERALD binding names this workflow + class.
      "name": "herald-workflow",
      "binding": "HERALD_WORKFLOW",
      "class_name": "HeraldWorkflow"
    }
  ],
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "queenos" }],
  "durable_objects": {
    "bindings": [
      // Cross-script DO RPC to the Queen (apps/queen wrangler "name": "queen").
      // One QueenNode per hive: QUEEN.idFromName(hive).
      { "name": "QUEEN", "class_name": "QueenNode", "script_name": "queen" }
    ]
  },
  // Deploy credentials come from the Vault, per hive: no Cloudflare token or
  // account id in this Worker's config or secrets (docs/deploy-discovery.md §6).
  // VaultReader is the Vault's read entrypoint; only the Herald binds it.
  "services": [{ "binding": "VAULT_READER", "service": "queenos-vault", "entrypoint": "VaultReader" }],
  "env": {
    // Used only by vitest (see vitest.config.ts). Named envs do not inherit
    // bindings: no ARTIFACTS (remote-only) and no cross-script QUEEN DO (the pool
    // has no dev registry). Tests inject fake ports via test/worker.ts.
    "test": {
      // No VAULT_READER either: tests inject fake credentials.
      "workflows": [{ "name": "herald-workflow", "binding": "HERALD_WORKFLOW", "class_name": "HeraldWorkflow" }]
    }
  }
}
